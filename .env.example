# Generate a token with: uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'
SENTINEL_TOKEN=
# Generate a DIFFERENT token for the agent (no operator permissions).
SENTINEL_AGENT_TOKEN=
# Supply the exact base URL and API-key VARIABLE NAME from Baseten documentation.
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Confirmed in Baseten model listing; the requested -1026 ID returned 404.
BASETEN_MODEL=meta-models/muse-spark-open
BASETEN_API_KEY_ENV=BASETEN_API_KEY
BASETEN_API_KEY=
# Put the actual key in that named environment variable locally.
# Optional rule compiler: exact values from your Meta Model API documentation.
META_BASE_URL=
META_MODEL=
META_API_KEY_ENV=
